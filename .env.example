# Copy to .env and fill in real values. Never commit .env.
#
# docker compose reads this file automatically. It needs DB_USERNAME,
# DB_PASSWORD and JWT_SECRET; it sets DB_URL and REDIS_* itself.
# The DB_URL and REDIS_* values below are for running the app outside Docker.

DB_URL=
DB_USERNAME=
DB_PASSWORD=
# At least 32 characters
JWT_SECRET=
# Token lifetimes (Spring Duration format, e.g. 15m, 1h, 7d)
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Redis (leave REDIS_PASSWORD empty if Redis has no auth)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional admin seed: if both are set, this ADMIN is created on startup when it doesn't
# exist yet. Never promotes an existing user or changes an existing password.
# Set both or neither; the password needs at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OpenAPI spec (/v3/api-docs) and Swagger UI (/swagger-ui.html); set to false to hide them
OPENAPI_ENABLED=true

# Rate limiting of failed password attempts (defaults shown; per window)
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_CHANGE_PASSWORD=5

# Log every SQL statement (local debugging only)
SHOW_SQL=false

# docker compose only: host port for the API (default 8080)
APP_PORT=8080
