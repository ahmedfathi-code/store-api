# Copy to .env and fill in real values. Never commit .env.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
# Token lifetimes (Spring Duration format, e.g. 15m, 1h, 7d)
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Redis (leave REDIS_PASSWORD empty if Redis has no auth)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
